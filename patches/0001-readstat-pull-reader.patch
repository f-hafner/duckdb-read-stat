 }
diff --git a/src/readstat_parser.c b/src/readstat_parser.c
index e5c4625..f20d13b 100644
--- a/src/readstat_parser.c
+++ b/src/readstat_parser.c
@@ -1,6 +1,7 @@
 
 #include <stdlib.h>
 #include "readstat.h"
+#include "readstat_reader.h"
 #include "readstat_io_unistd.h"
 
 readstat_parser_t *readstat_parser_init(void) {
@@ -119,3 +120,191 @@ readstat_error_t readstat_set_row_offset(readstat_parser_t *parser, long row_off
     parser->row_offset = row_offset;
     return READSTAT_OK;
 }
+
+readstat_index_t *readstat_index_alloc(readstat_file_format_t format) {
+    readstat_index_t *index = calloc(1, sizeof(readstat_index_t));
+    if (index == NULL)
+        return NULL;
+    index->format = format;
+    return index;
+}
+
+readstat_error_t readstat_index_append(readstat_index_t *index,
+        const void *entry) {
+    if (index == NULL || index->entry_size == 0)
+        return READSTAT_ERROR_MALLOC;
+
+    if (index->count == index->capacity) {
+        size_t capacity = index->capacity ? index->capacity * 2 : 64;
+        void *entries = realloc(index->entries, capacity * index->entry_size);
+        if (entries == NULL)
+            return READSTAT_ERROR_MALLOC;
+        index->entries = entries;
+        index->capacity = capacity;
+    }
+
+    memcpy((char *)index->entries + index->count * index->entry_size,
+            entry, index->entry_size);
+    index->count++;
+    return READSTAT_OK;
+}
+
+void readstat_index_free(readstat_index_t *index) {
+    if (index == NULL)
+        return;
+    free(index->entries);
+    free(index);
+}
+
+int64_t readstat_index_get_row_count(const readstat_index_t *index) {
+    return index == NULL ? -1 : index->row_count;
+}
+
+readstat_index_t *readstat_index_build(readstat_parser_t *parser,
+        readstat_file_format_t format, const char *path, void *user_ctx,
+        readstat_error_t *out_error) {
+    readstat_error_t error = READSTAT_ERROR_UNSUPPORTED_OPERATION;
+    readstat_index_t *index = NULL;
+
+    if (parser == NULL) {
+        if (out_error)
+            *out_error = READSTAT_ERROR_PARSE;
+        return NULL;
+    }
+
+    switch (format) {
+        case READSTAT_FILE_FORMAT_SAV:
+            index = readstat_sav_index_build(parser, path, user_ctx, &error);
+            break;
+        case READSTAT_FILE_FORMAT_POR:
+            index = readstat_por_index_build(parser, path, user_ctx, &error);
+            break;
+        case READSTAT_FILE_FORMAT_SAS7BDAT:
+            index = readstat_sas7bdat_index_build(parser, path, user_ctx, &error);
+            break;
+        case READSTAT_FILE_FORMAT_XPORT:
+            index = readstat_xport_index_build(parser, path, user_ctx, &error);
+            break;
+        default:
+            error = READSTAT_ERROR_UNSUPPORTED_OPERATION;
+            break;
+    }
+
+    if (index == NULL && out_error)
+        *out_error = error;
+    return index;
+}
+
+readstat_reader_t *readstat_reader_alloc(readstat_parser_t *parser,
+        readstat_file_format_t format, void *user_ctx) {
+    readstat_reader_t *reader = calloc(1, sizeof(readstat_reader_t));
+    if (reader == NULL)
+        return NULL;
+
+    reader->parser = parser;
+    reader->format = format;
+    reader->user_ctx = user_ctx;
+    return reader;
+}
+
+void readstat_reader_free(readstat_reader_t *reader) {
+    if (reader == NULL)
+        return;
+
+    if (!reader->closed && reader->close)
+        reader->close(reader);
+    free(reader);
+}
+
+readstat_reader_t *readstat_reader_open(readstat_parser_t *parser,
+        readstat_file_format_t format, const char *path, void *user_ctx,
+        readstat_error_t *out_error) {
+    readstat_reader_t *reader = NULL;
+    readstat_error_t error = READSTAT_ERROR_PARSE;
+
+    if (parser == NULL) {
+        if (out_error)
+            *out_error = READSTAT_ERROR_PARSE;
+        return NULL;
+    }
+
+    switch (format) {
+        case READSTAT_FILE_FORMAT_DTA:
+            reader = readstat_dta_reader_open(parser, path, user_ctx, &error);
+            break;
+        case READSTAT_FILE_FORMAT_SAV:
+            reader = readstat_sav_reader_open(parser, path, user_ctx, &error);
+            break;
+        case READSTAT_FILE_FORMAT_POR:
+            reader = readstat_por_reader_open(parser, path, user_ctx, &error);
+            break;
+        case READSTAT_FILE_FORMAT_SAS7BDAT:
+            reader = readstat_sas7bdat_reader_open(parser, path, user_ctx, &error);
+            break;
+        case READSTAT_FILE_FORMAT_XPORT:
+            reader = readstat_xport_reader_open(parser, path, user_ctx, &error);
+            break;
+        default:
+            error = READSTAT_ERROR_PARSE;
+            break;
+    }
+
+    if (reader == NULL && out_error)
+        *out_error = error;
+
+    return reader;
+}
+
+readstat_error_t readstat_reader_read_rows(readstat_reader_t *reader, size_t max_rows) {
+    readstat_error_t retval;
+
+    if (reader == NULL)
+        return READSTAT_ERROR_PARSE;
+    if (reader->error != READSTAT_OK)
+        return reader->error;
+    if (reader->eof || max_rows == 0)
+        return READSTAT_OK;
+
+    retval = reader->read_rows(reader, max_rows);
+    if (retval != READSTAT_OK)
+        reader->error = retval;
+    return retval;
+}
+
+readstat_error_t readstat_reader_set_index(readstat_reader_t *reader,
+        const readstat_index_t *index) {
+    if (reader == NULL)
+        return READSTAT_ERROR_PARSE;
+    if (index != NULL && index->format != reader->format)
+        return READSTAT_ERROR_PARSE;
+    reader->index = index;
+    return READSTAT_OK;
+}
+
+readstat_error_t readstat_reader_set_range(readstat_reader_t *reader,
+        int64_t start_row, int64_t row_count) {
+    readstat_error_t retval;
+
+    if (reader == NULL)
+        return READSTAT_ERROR_PARSE;
+    if (reader->error != READSTAT_OK)
+        return reader->error;
+    if (reader->set_range == NULL)
+        return READSTAT_ERROR_UNSUPPORTED_OPERATION;
+
+    retval = reader->set_range(reader, start_row, row_count);
+    if (retval == READSTAT_OK) {
+        reader->eof = 0;
+    } else {
+        reader->error = retval;
+    }
+    return retval;
+}
+
+int readstat_reader_is_eof(const readstat_reader_t *reader) {
+    return reader == NULL || reader->eof;
+}
+
+void readstat_reader_close(readstat_reader_t *reader) {
+    readstat_reader_free(reader);
+}
