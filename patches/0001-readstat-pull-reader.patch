+readstat_index_t *readstat_sav_index_build(readstat_parser_t *parser,
+        const char *path, void *user_ctx, readstat_error_t *out_error) {
+    readstat_value_handler old_value_handler = parser->handlers.value;
+    readstat_error_t error = READSTAT_OK;
+    readstat_index_t *index = NULL;
+    readstat_reader_t *reader = NULL;
+    sav_ctx_t *ctx;
+
+    parser->handlers.value = sav_index_value_handler;
+    reader = readstat_sav_reader_open(parser, path, user_ctx, &error);
+    parser->handlers.value = old_value_handler;
+
+    if (reader == NULL)
+        goto cleanup;
+
+    ctx = (sav_ctx_t *)reader->ctx;
+    index = readstat_index_alloc(READSTAT_FILE_FORMAT_SAV);
+    if (index == NULL) {
+        error = READSTAT_ERROR_MALLOC;
+        goto cleanup;
+    }
+
+    if (ctx->compression == READSTAT_COMPRESS_ROWS) {
+        error = sav_rle_build_index(ctx, index);
+#if HAVE_ZLIB
+    } else if (ctx->compression == READSTAT_COMPRESS_BINARY) {
+        error = readstat_zsav_build_index(ctx, index);
+#endif
+    } else {
+        error = READSTAT_ERROR_UNSUPPORTED_OPERATION;
+    }
+
+cleanup:
+    if (reader)
+        readstat_reader_close(reader);
+    if (error != READSTAT_OK) {
