+static readstat_error_t dta_reader_read_rows(readstat_reader_t *reader, size_t max_rows) {
+    dta_ctx_t *ctx = (dta_ctx_t *)reader->ctx;
+    size_t rows = 0;
+    readstat_error_t retval;
+
+    retval = dta_handle_rows(ctx, max_rows, &rows);
+    if (retval != READSTAT_OK)
+        return retval;
+
+    if (ctx->data_finished || rows == 0)
+        reader->eof = 1;
+
+    return READSTAT_OK;
+}
+
+static readstat_error_t dta_reader_set_range(readstat_reader_t *reader,
+        int64_t start_row, int64_t row_count) {
+    dta_ctx_t *ctx = (dta_ctx_t *)reader->ctx;
+    int64_t remaining;
+    int64_t row_limit;
+    int64_t data_offset;
+
+    if (ctx == NULL || !ctx->data_started)
+        return READSTAT_ERROR_PARSE;
+
+    if (start_row < 0)
+        start_row = 0;
+    if (start_row > ctx->nobs)
+        start_row = ctx->nobs;
+
+    remaining = ctx->nobs - start_row;
+    row_limit = row_count < 0 || row_count > remaining ? remaining : row_count;
+
+    data_offset = ctx->data_rows_offset + (int64_t)ctx->record_len * start_row;
+    if (ctx->io->seek(data_offset, READSTAT_SEEK_SET, ctx->io->io_ctx) == -1)
+        return READSTAT_ERROR_SEEK;
+
+    ctx->row_offset = 0;
+    ctx->current_row = 0;
+    ctx->row_limit = row_limit;
+    ctx->data_finished = 0;
+
+    return READSTAT_OK;
+}
+
+static void dta_reader_close(readstat_reader_t *reader) {
+    dta_ctx_t *ctx = (dta_ctx_t *)reader->ctx;
+
+    if (ctx) {
+        if (ctx->data_started && ctx->current_row >= ctx->row_limit)
+            dta_read_tag(ctx, "</data>");
+
+        if (ctx->data_started)
+            dta_handle_value_labels(ctx);
+
+        ctx->io->close(ctx->io->io_ctx);
+        dta_ctx_free(ctx);
+        reader->ctx = NULL;
+    }
+
+    reader->closed = 1;
+}
+
+readstat_error_t readstat_parse_dta(readstat_parser_t *parser, const char *path, void *user_ctx) {
+    readstat_error_t error = READSTAT_OK;
+    readstat_reader_t *reader = readstat_dta_reader_open(parser, path, user_ctx, &error);
+
+    if (reader == NULL)
+        return error;
+
+    while (!readstat_reader_is_eof(reader)) {
+        error = readstat_reader_read_rows(reader, (size_t)-1);
+        if (error != READSTAT_OK) {
+            readstat_reader_close(reader);
+            return error;
+        }
+    }
+
+    readstat_reader_close(reader);
+
+    return READSTAT_OK;
